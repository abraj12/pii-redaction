NODE_ENV=production
PORT=10000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/pii-redaction

# Authentication
JWT_SECRET=YOUR_LONG_RANDOM_PRODUCTION_SECRET
JWT_EXPIRES_IN=1d

# Frontend configuration (Used for CORS)
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# PII Engine Configuration
# In Render, this should be the public service URL (e.g. https://pii-redaction-1.onrender.com)
PII_ENGINE_URL=https://pii-redaction-1.onrender.com

# File Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
GENERATED_DIR=generated

# Advanced Configurations
PII_CHUNK_SIZE=45000
PII_CHUNK_OVERLAP=500
EXTRACTION_TIMEOUT_MS=60000
PII_TIMEOUT_MS=120000
REDACTION_TIMEOUT_MS=120000
TOTAL_PROCESSING_TIMEOUT_MS=300000
